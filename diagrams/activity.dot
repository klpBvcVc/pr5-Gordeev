digraph G {
graph [rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.4, ranksep=0.45];
node [shape=box, style="rounded,filled", fontname="Sans", fontsize=12, color="#2F5597", fillcolor="#EAF2F8", margin="0.14,0.09"];
edge [fontname="Sans", fontsize=10, color="#555555"];
start [label="Начало", shape=oval, fillcolor="#E2F0D9", color="#548235"];
end [label="Завершение", shape=oval, fillcolor="#FCE4D6", color="#C65911"];
n1 [label="Получить строку часов", shape=parallelogram, fillcolor="#E4DFEC", color="#7030A0"];
n2 [label="Разделить строку: split(\";\", -1)\nи отбросить пустые значения\nв начале и в конце (вариант 13)"];
n3 [label="Ровно пять значений?", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
n4 [label="Для каждого из 5 элементов (цикл for):\nпроверить формат ^(0|[1-9][0-9]*)$\nи диапазон [0, 16], преобразовать в int"];
n5 [label="Все элементы корректны?", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
n6 [label="Вычислить сумму, среднее,\nдни с переработкой (v > 8),\nнедельную переработку max(0, сумма - 40)\nи минимальный рабочий день"];
n7 [label="Собрать итоговый отчёт:\nсумма, среднее (2 знака),\nдней с переработкой, недельная переработка,\nсамый короткий рабочий день"];
n8 [label="Сформировать сообщение об ошибке:\nпозиция N или структура"];
start -> n1;
n1 -> n2;
n2 -> n3;
n3 -> n4 [label="да"];
n3 -> n8 [label="нет"];
n4 -> n4 [label="следующий элемент"];
n4 -> n5;
n5 -> n6 [label="да"];
n5 -> n8 [label="нет (первая ошибка, fail-fast)"];
n6 -> n7;
n7 -> end;
n8 -> end;
}
